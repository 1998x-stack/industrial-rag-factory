DEEPSEEK_BASE_URL=https://api.deepseek.com
# Official DeepSeek V4.1 Flash API alias
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_API_KEY=
IRF_GENERATOR=extractive
IRF_DB_PATH=./data/stage01.sqlite3
# hashing is a lexical vector baseline, NOT a semantic embedding model
IRF_DENSE_BACKEND=hashing
IRF_DENSE_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
IRF_TENANT_ID=demo
IRF_GROUPS=demo-readers
IRF_ENV=development
IRF_HOST=127.0.0.1
IRF_PORT=5000

# Stage 04 rules (offline) or deepseek (opt-in API call + cost)
IRF_PLANNER=rules
